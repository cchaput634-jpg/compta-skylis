{
  "name": "skylis-compta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --proxy 5178 --port 8787 --ip 127.0.0.1 --local",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:init:local": "wrangler d1 execute skylis-compta-db --local --file=./worker/schema.sql",
    "db:init:remote": "wrangler d1 execute skylis-compta-db --remote --file=./worker/schema.sql",
    "deploy": "vite build && wrangler pages deploy ./dist"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "wrangler": "^4.20.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
